{
  "manifest_version": 3,
  "name": "Amazon Bulk Cancel for Subscribe & Save",
  "version": "26.0.0",
  "description": "Cancel Amazon Subscribe & Save subscriptions in bulk. Draggable panel with live progress, adjustable parallel cancellations, retries, and a stop button. UK / US / DE.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-48.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Amazon Bulk Cancel — open Subscribe & Save on Amazon"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/auto-deliveries*",
        "https://www.amazon.com/auto-deliveries*",
        "https://www.amazon.de/auto-deliveries*",
        "https://www.amazon.co.uk/gp/subscribe-and-save/manager/viewsubscriptions*",
        "https://www.amazon.com/gp/subscribe-and-save/manager/viewsubscriptions*",
        "https://www.amazon.de/gp/subscribe-and-save/manager/viewsubscriptions*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "homepage_url": "https://github.com/Ropaxyz/Bulk-Cancel-for-Amazon-Subscribe-Save"
}
